<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <Version>1.0.1</Version>
                <AssemblyVersion>1.0.1.0</AssemblyVersion>
                <FileVersion>1.0.1.0</FileVersion>
        <Product>AssetRipperPatcher</Product>
        <Description>Export enhancements for AssetRipper: shader decompilation, sprite mesh/outline repair, alpha textures, legacy fonts.</Description>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="AssetRipper.Primitives" Version="3.2.0" />
      <PackageReference Include="DXDecompiler-ly" Version="0.0.1" />
      <PackageReference Include="Lib.Harmony" Version="2.4.2" />
      <!-- Sprite 轮廓生成的三角化：libtess2 的 C# 移植（MIT），对应 Unity 原版的外部依赖 libtess2。 -->
      <PackageReference Include="LibTessDotNet" Version="1.1.15" />
      <PackageReference Include="NativeFileDialog" Version="1.0.0" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
      <!-- 桌面外壳：Photino.NET 只是原生窗口 + WebView2 宿主，界面本身是本地网页。 -->
      <PackageReference Include="Photino.NET" Version="4.0.16" />
    </ItemGroup>

    <!-- 自检测试项目需要访问 internal 类型（Patch 类、Program 等）。 -->
    <ItemGroup>
      <InternalsVisibleTo Include="AssetRipperPatcher.Tests" />
    </ItemGroup>

    <!-- 注解校验分析器：编译期照 [PatchMethod]/[Access*] 注解做 HRP 诊断。
         ProjectReference + OutputItemType="Analyzer" 是「项目内分析器」的标准接法：
         csc 拿到 /analyzer:，Rider 的 Roslyn worker 也按「引用项目产出的分析器」处理。
         不要再额外加静态 <Analyzer Include=...> —— 同一个 dll 从两条路径进来会让每条
         诊断报两遍。 -->
    <ItemGroup>
      <ProjectReference Include="..\AssetRipperPatcher.Tools\AssetRipperPatcher.Tools.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!-- Plugins/ holds Unity Editor scripts that go into an unpacked game
         project's Assets/Editor after export.  They are payload, not program:
         excluded from compilation and analysis (they reference UnityEditor,
         which this project does not), and copied verbatim to the output so the
         folder can be handed over as-is. -->
    <ItemGroup>
        <Compile Remove="Plugins\**\*.cs" />
        <None Remove="Plugins\**" />
        <Content Include="Plugins\**\*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

        <!-- 新 Web UI 的前端资源（HTML/CSS/JS + 打包好的 Fluent 组件）。
             必须进输出目录，否则发布后的 exe 找不到界面。
             TargetPath 把 WebUi\wwwroot\** 平铺成输出里的 wwwroot\**（LinkBase 对 Content 不生效）。 -->
        <ItemGroup>
                <None Remove="WebUi\wwwroot\**" />
                <Content Include="WebUi\wwwroot\**\*" TargetPath="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
            </ItemGroup>

            <!-- 许可证必须随二进制一起分发：GPL-3.0 §6 要求附带许可证副本，
                 Apache-2.0 §4(a) 要求附带其副本与 NOTICE。
                 ShaderRipper 是 Apache-2.0 且带 GPL 链接例外，两个文件都要。
                 源路径都在仓库根，用 Link 把它们放进输出的 licenses\ 下。 -->
            <ItemGroup>
                <None Include="..\License" Link="licenses\LICENSE-GPL-3.0.txt"
                      CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
                <None Include="..\ShaderRipper\LICENSE" Link="licenses\LICENSE-ShaderRipper-Apache-2.0.txt"
                      CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
                <None Include="..\ShaderRipper\LICENSE-EXCEPTION" Link="licenses\LICENSE-EXCEPTION-ShaderRipper-GPL.txt"
                      CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
                <None Include="..\docs\THIRD-PARTY-NOTICES.md" Link="licenses\THIRD-PARTY-NOTICES.md"
                      CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
            </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\AssetRipper\Source\AssetRipper.GUI.Web\AssetRipper.GUI.Web.csproj" />
      <!-- The decompiler library, referenced so the patcher can call it in-process
                 instead of spawning ShaderRipper.exe and reading files back.
                 ShaderRipper is a git submodule pinned to tag v1.2.2. -->
            <ProjectReference Include="..\ShaderRipper\src\ShaderRipper\ShaderRipper.csproj" />
    </ItemGroup>

    <!-- Publish the library next to the patcher binary, so a build leaves a
         drop-in `ShaderRipper.dll` (+ its pdb) in a fixed location that other
         tooling can copy from.

         Build 和 Publish 各挂一个 target：Publish 不会触发 Build 的 AfterTargets，
         而 `dotnet publish` 的产物目录是 $(PublishDir) 而不是 $(OutDir)。 -->
    <PropertyGroup>
        <ShaderRipperLibDir>$(MSBuildThisFileDirectory)..\ShaderRipper\src\ShaderRipper\bin\$(Configuration)\$(TargetFramework)\</ShaderRipperLibDir>
    </PropertyGroup>

    <ItemGroup>
        <ShaderRipperBin Include="$(ShaderRipperLibDir)ShaderRipper.dll" />
        <ShaderRipperBin Include="$(ShaderRipperLibDir)ShaderRipper.pdb" />
    </ItemGroup>

    <Target Name="CopyShaderRipperLibrary" AfterTargets="Build">
        <Copy SourceFiles="@(ShaderRipperBin)" DestinationFolder="$(OutDir)ShaderRipper" SkipUnchangedFiles="true" Condition="Exists('$(ShaderRipperLibDir)ShaderRipper.dll')" />
        <Warning Text="ShaderRipper.dll not found at $(ShaderRipperLibDir); build that project first." Condition="!Exists('$(ShaderRipperLibDir)ShaderRipper.dll')" />
        <Message Importance="high" Text="ShaderRipper library -&gt; $(OutDir)ShaderRipper" Condition="Exists('$(ShaderRipperLibDir)ShaderRipper.dll')" />
    </Target>

    <Target Name="CopyShaderRipperLibraryOnPublish" AfterTargets="Publish">
        <Copy SourceFiles="@(ShaderRipperBin)" DestinationFolder="$(PublishDir)ShaderRipper" SkipUnchangedFiles="true" Condition="Exists('$(ShaderRipperLibDir)ShaderRipper.dll')" />
        <Message Importance="high" Text="ShaderRipper library -&gt; $(PublishDir)ShaderRipper" Condition="Exists('$(ShaderRipperLibDir)ShaderRipper.dll')" />
    </Target>

</Project>
