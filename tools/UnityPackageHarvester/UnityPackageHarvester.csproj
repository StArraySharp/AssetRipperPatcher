<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 独立的开发期工具，不参与主程序构建，也不随发布分发。
         它的产物是两份纯数据文件，被主工程编译进去：

           AssetRipperPatcher/PackageFromAssembly.Generated.cs   程序集名 -> UPM 包
           AssetRipperPatcher/PackageTypeGuid.Generated.cs       可序列化类型 -> .cs.meta GUID

         它与主工程**没有** ProjectReference：工具只「生成数据」，主工程只「读数据」，
         所以可以随时重跑工具而不影响主工程的构建图。 -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>AssetRipperPatcher.Tools.UnityPackages</RootNamespace>
    <AssemblyName>UnityPackageHarvester</AssemblyName>
    <Version>1.0.0</Version>
    <Description>Harvests Unity's package registry: assembly names and serializable type GUIDs.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 用真正的 C# 语法树解析包里的源码：正则处理不了 partial class、
         嵌套类、文件里多个类、#if 条件编译，而这些在 Unity 包里很常见。 -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

</Project>